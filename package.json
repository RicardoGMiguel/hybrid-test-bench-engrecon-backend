{
  "name": "template-node-v2",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "type": "commonjs",
  "bin": "./dist/shared/infra/http/server.js",
  "prisma": {
    "seed": "tsx ./prisma/seed.ts"
  },
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "dev": "cross-env PRODUCTION=false tsx watch ./src/shared/infra/http/server.ts",
    "start": "cross-env PRODUCTION=true node dist/shared/infra/http/server.js",
    "build": "babel src --extensions \".js,.ts\" --out-dir dist --copy-files",
    "package": "yarn build && pkg .",
    "test:ci": "cross-env SKIP_ENV_VALIDATION=true ORM=test vitest --watch=false --coverage --no-file-parallelism",
    "test": "cross-env SKIP_ENV_VALIDATION=true ORM=test vitest --coverage --pool=threads",
    "test:ui": "yarn test --ui",
    "prepare": "husky install",
    "format": "prettier --write \"src\"",
    "lint": "eslint src",
    "typeorm": "ts-node-dev  -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "typeorm:migration:create": "yarn typeorm migration:create",
    "typeorm:migration:run": "yarn typeorm migration:run -d ./src/config/orm/index.ts",
    "typeorm:migration:revert": "yarn typeorm migration:revert -d ./src/config/orm/index.ts",
    "typeorm:schema:drop": "yarn typeorm schema:drop -d ./src/config/orm/index.ts"
  },
  "pkg": {
    "version": "1.0.0",
    "name": "template-node-v2",
    "outputPath": "production",
    "assets": [
      ".env*",
      "tmp/*",
      "tmp/**/*",
      "frontEnd/*",
      "frontEnd/**/*",
      "node_modules/swagger-ui-dist/**/*",
      "node_modules/.prisma/client/*.node"
    ],
    "targets": [
      "node18",
      "node18-linux"
    ]
  },
  "lint-staged": {
    "*.{ts}": [
      "eslint src --fix"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/multer": "^1.4.7",
    "@types/node": "^17.0.40",
    "@types/nodemailer": "^6.4.15",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "eslint": "^9.19.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "nodemon": "^2.0.16",
    "prettier": "^3.4.2",
    "ts-node-dev": "^2.0.0",
    "tsup": "^6.5.0",
    "tsx": "^4.16.5",
    "typescript": "^4.8.0",
    "vitest": "^3.0.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.620.0",
    "@aws-sdk/client-ses": "^3.620.0",
    "@babel/cli": "^7.15.4",
    "@babel/core": "^7.15.5",
    "@babel/node": "^7.15.4",
    "@babel/plugin-proposal-class-properties": "^7.14.5",
    "@babel/plugin-proposal-decorators": "^7.15.4",
    "@babel/preset-env": "^7.15.6",
    "@babel/preset-typescript": "^7.15.0",
    "@prisma/client": "^4.9.0",
    "@types/ws": "^8.18.1",
    "babel-plugin-module-resolver": "^4.1.0",
    "babel-plugin-transform-typescript-metadata": "^0.3.2",
    "bcryptjs": "^3.0.2",
    "celebrate": "^15.0.1",
    "class-transformer": "^0.5.1",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^16.0.1",
    "express": "^4.18.1",
    "express-async-errors": "^3.1.1",
    "express-basic-auth": "^1.2.1",
    "express-winston": "^4.2.0",
    "fast-glob": "^3.3.1",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.2",
    "mime": "^4.0.4",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "pg": "^8.8.0",
    "pkg": "^5.8.1",
    "prisma": "^4.9.0",
    "rate-limiter-flexible": "^2.3.7",
    "reflect-metadata": "^0.1.13",
    "regenerator-runtime": "^0.13.9",
    "serialport": "^13.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.0",
    "tsyringe": "^4.7.0",
    "typeorm": "^0.3.11",
    "uuid": "^8.3.2",
    "winston": "^3.8.2",
    "winston-daily-rotate-file": "^4.7.1",
    "ws": "^8.18.3",
    "zod": "^3.20.6"
  }
}
